  msgSelector.addEventListener('change', () => { stashActiveMsgChanges(); refreshMsgForm(); });
  locSelector.addEventListener('change', () => { stashActiveLocChanges(); refreshLocForm(); });

  populateMsgDropdown(0); refreshMsgForm();
  populateLocDropdown(0); refreshLocForm();

  document.getElementById('modal-save-btn').addEventListener('click', () => {
    stashActiveMsgChanges();
    stashActiveLocChanges();

    runtimeLocations.forEach(loc => {
      if (loc.className === "NEW_LOC" || !loc.className) {
        loc.className = determineLocationClassName(loc.label);
      }
    });

    localStorage.setItem('customMessages', JSON.stringify(runtimeCollection));
    localStorage.setItem('customLocations', JSON.stringify(runtimeLocations));

    settingsOverlay.remove();
    populateMsgs('msg-buttons');
  });

  document.getElementById('modal-cancel-btn').addEventListener('click', () => settingsOverlay.remove());
}




// Setup Application Lifecycle Hooks
document.addEventListener('DOMContentLoaded', () => {
  const backBtn = document.querySelector('.backBtn');
  const copyBtn = document.getElementById('copyBtn');
  const backContainer = document.getElementById('back');

   const extractBtn = document.getElementById('extractBtn');
  if (extractBtn) {
    extractBtn.addEventListener('click', () => {
      try {
        // 1. Create a secure, invisible layout scratchpad element to grab paste actions
        const scraper = document.createElement('textarea');
        scraper.style.position = 'fixed';
        scraper.style.opacity = '0';
        document.body.appendChild(scraper);
        
        // 2. Drive focal context onto it and run a direct browser clipboard read paste
        scraper.focus();
        const pasteSuccess = document.execCommand('paste');
        const text = scraper.value ? scraper.value.trim() : '';
        
        // Wipe the temporary node immediately to preserve DOM hygiene
        document.body.removeChild(scraper);

        if (!pasteSuccess || !text) {
          throw new Error('Paste command failed or clipboard context is empty.');
        }

        // Variables to house final extracted values
        let d = '';
        let c = '';
        let p = '';

        // 3. Dual-Parsing Router Logic
        if (text.includes('|')) {
          // FORMAT A: Pipe-delimited string (e.g., "keeshon|15097|20")
          const parts = text.split('|');
          d = parts[0] ? parts[0].trim() : '';
          c = parts[1] ? parts[1].trim() : '';
          p = parts[2] ? parts[2].trim() : '';
        } else {
          // FORMAT B: Raw text block scanner fallback
          const driverMatch = text.match(/Drivers\b\s*[:\-]?\s*(\w+(?:\s+\w+)?)/i);
          const carMatch = text.match(/Car\s+(\d+)/i);
          const percentMatch = text.match(/(\d{2})%/);

          d = driverMatch ? driverMatch[1].trim() : '';
          c = carMatch ? carMatch[1].trim() : '';
          p = percentMatch ? percentMatch[1].trim() : '';
        }

        // 4. Sanitize placeholder marks (like "-- / --" or "--") out of driver name string
        if (/^[\s\-\/]+$/.test(d)) {
          d = '';
        }

        // 5. Connect cleanly with your existing layout target input selectors
        const ldapInput = document.getElementById('ldap-input');
        const carInput = document.getElementById('car-input');
        const chargeInput = document.getElementById('charge-input');

        // 6. Inject the cleaned data and synchronize state with localStorage balances
        if (ldapInput) {
          ldapInput.value = d;
          localStorage.setItem('globalLdap', d);
        }
        if (carInput) {
          carInput.value = c;
          localStorage.setItem('globalCar', c);
        }
        if (chargeInput) {
          chargeInput.value = p;
          localStorage.setItem('globalCharge', p);
        }

        // 7. Fire a visual success status directly on the button label
        extractBtn.textContent = '✅ Data Extracted!';
        extractBtn.style.borderColor = '#10b981';
        setTimeout(() => {
          extractBtn.textContent = '📋 Extract Clipboard Data';
          extractBtn.style.borderColor = 'var(--accent)';
        }, 1200);

      } catch (err) {
        console.error('Extraction lifecycle failure:', err);
        alert('Extraction failed. Verify "clipboardRead" is active in manifest.json, reload, and try again.');
      }
    });
  }

  const setMsgBtn = document.getElementById('set-msg-btn');
  if (setMsgBtn) {
    setMsgBtn.addEventListener('click', launchMessagesSettingsPanel);
  }

  const menuDotsBtn = document.getElementById('menu-dots-btn');
  if (menuDotsBtn) {
    menuDotsBtn.addEventListener('click', launchMessagesSettingsPanel);
  }

  backBtn.addEventListener('click', () => {
    if (currentActiveView === 'geos') {
      document.getElementById('geo-buttons').hidden = true;
      backContainer.hidden = true;
      populateMsgs('msg-buttons');
    } else if (currentActiveView === 'misc') {
      document.getElementById('misc-fields').hidden = true;
      populateGeos('geo-buttons');
    } else if (currentActiveView === 'geos_skipped') {
      document.getElementById('misc-fields').hidden = true;
      backContainer.hidden = true;
      populateMsgs('msg-buttons');
    }
  });

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await retreiveGlobalMsg();
        const msg = localStorage.getItem("globalMsg") || '';
        const htmlBlob = new Blob([msg], { type: 'text/html' });
        await navigator.clipboard.write([
          new ClipboardItem({ 'text/html': htmlBlob })
        ]);

        const messageElement = document.getElementById('message');
        if (messageElement) {
          messageElement.removeAttribute('hidden');
        }
        showCopiedToast();

        const keysToClean = ['globalLabel', 'globalMisc', 'globalGeo_on', 'globalGeo', 'globalLdap', 'globalCar', 'globalCharge', 'globalMsg'];
        keysToClean.forEach(k => localStorage.removeItem(k));

        const inputFields = ['ldap', 'car', 'charge'];
        inputFields.forEach(fieldId => {
          const inputElement = document.getElementById(fieldId);
          if (inputElement) {
            inputElement.value = '';
          }
        });
      } catch (err) {
        console.error('Failed to copy text layout: ', err);
      }
    });
  }
  populateMsgs('msg-buttons');
});